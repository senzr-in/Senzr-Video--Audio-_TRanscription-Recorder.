# ─────────────────────────────────────────────────────────────────────────────
# Edge Gateway OTA / FOTA Updater Configuration
# Place this file on the device at: /opt/edge-gateway/updater_config.env
# ─────────────────────────────────────────────────────────────────────────────

# Unique Identifier for this device (Hardware MAC Address).
# If left blank or commented out, the updater automatically resolves the physical
# hardware MAC address of the active network interface (e.g. c4:54:e8:12:34:56).
# If you want to explicitly pin a specific MAC address:
# DEVICE_ID=c4:54:e8:12:34:56

# AWS S3 Storage
S3_BUCKET=senzr-fota-storage
S3_PREFIX=app-releases
S3_REGION=us-east-1

# Optional AWS Credentials (leave blank if using IAM Roles / IRSA or public read releases)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# MQTT Broker (Used for real-time update triggers, telemetry heartbeat, and status reporting)
MQTT_BROKER=mqtt.fieldseasy.com
MQTT_PORT=1883

# Broadcast update topic (all devices listen here by default)
MQTT_TOPIC=edge-gateway/update

# Local directories
CURRENT_DIR=/opt/edge-gateway/current
BACKUP_DIR=/opt/edge-gateway/backup
DOWNLOADS_DIR=/opt/edge-gateway/downloads

# Periodic fallback check interval (seconds)
CHECK_INTERVAL=60

# Systemd service controlled by the updater
APP_SERVICE=edge-gateway

# Health check endpoint used to verify successful startup before completing update
HEALTH_CHECK_URL=http://127.0.0.1:8000/api/status

# Optional: set to true to trigger full Linux OS reboot after successful update.
# By default (false), it only restarts the edge-gateway application service without board reboot.
# REBOOT_AFTER_UPDATE=false

# ─────────────────────────────────────────────────────────────────────────────
# Security, State Tracking & Anti-Rollback
# ─────────────────────────────────────────────────────────────────────────────

# Persistent transaction state file (used for automatic crash/power-cut recovery)
STATE_FILE=/opt/edge-gateway/fota_state.json

# OEM Public Key for verifying ECDSA/RSA cryptographic digital signatures
PUBLIC_KEY_FILE=/etc/senzr/certs/fota_public_key.pem

# Require digital signatures on all packages (reject unsigned releases)
ENFORCE_SIGNATURE=false

# Anti-Rollback: set to true only to allow intentional version downgrades
ALLOW_DOWNGRADE=false

