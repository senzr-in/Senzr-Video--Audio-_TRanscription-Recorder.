[Unit]
Description=Senzr Edge Gateway Production Daemon
After=network-online.target time-sync.target
Wants=network-online.target

[Service]
Type=simple
User=orangepi
WorkingDirectory=/home/orangepi/edge-gateway/cpp/build
ExecStart=/home/orangepi/edge-gateway/cpp/build/edge-gateway-backend
Restart=always
RestartSec=2
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
