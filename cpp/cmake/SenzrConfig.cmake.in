@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

find_dependency(Threads)
find_dependency(SQLite3)
find_dependency(CURL)
find_dependency(OpenSSL)

if(NOT TARGET Senzr::SDK)
    include("${CMAKE_CURRENT_LIST_DIR}/SenzrTargets.cmake")
    if(TARGET Senzr::senzr AND NOT TARGET Senzr::SDK)
        add_library(Senzr::SDK INTERFACE IMPORTED)
        target_link_libraries(Senzr::SDK INTERFACE Senzr::senzr)
    endif()
endif()

check_required_components(Senzr)
